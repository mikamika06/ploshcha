# Скопіювати в infra/.env на машині-сервері. У репозиторій НЕ комітиться.

# --- ключ моделі: єдине, що справді витрачає гроші ---
LAPA_API_KEY=

# --- тунель Cloudflare: Zero Trust → Networks → Tunnels → Create → скопіювати токен ---
CF_TUNNEL_TOKEN=

# --- стелі витрат: сторож спиняє цикл, коли перевищено ---
PLOSHCHA_MAX_TOKENS=1000000
PLOSHCHA_MAX_USD=5
PLOSHCHA_MAX_ITEMS=200

# --- сесії відвідувачів ---
PLOSHCHA_SESSION_TTL_DAYS=7
PLOSHCHA_MAX_SESSIONS=200
