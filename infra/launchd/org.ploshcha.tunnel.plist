<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>org.ploshcha.tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>exec /opt/homebrew/bin/cloudflared tunnel --no-autoupdate run --token "$(cat $HOME/.ploshcha-tunnel.token)"</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/macbook/.ploshcha-tunnel.log</string>
  <key>StandardErrorPath</key><string>/Users/macbook/.ploshcha-tunnel.log</string>
</dict>
</plist>
