{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@ploshcha/contract-ts": ["../../packages/contract-ts/src/index.ts"],
      "@fixtures/*": ["../../packages/fixtures/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
