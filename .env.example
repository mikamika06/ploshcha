# Шаблон середовища. Реальні значення — ТІЛЬКИ у .env (git-ignored).
# Скопіюй у .env і заповни ключ. Ключ ніколи не потрапляє на фронт і в трек.

# Провайдер: lapathoniia (хостований) | lapa_local | ollama
LAPA_PROVIDER=lapathoniia

# Lapa (OpenAI-сумісний). base_url ОБОВʼЯЗКОВО з /v1.
LAPA_API_KEY=
LAPA_BASE_URL=https://api.lapathoniia.top/v1
LAPA_MODEL=LapaLLM-Gemma-3-12B-instruct

# Погодинні ліміти бети: 1M вхідних / 250k згенерованих токенів.
# Стеля на один прогін (запобіжник cost-DoS):
LAPA_TOKEN_BUDGET_PER_RUN=40000

# Памʼять села — своя в кожного гостя (файл на сесію в <тека --db>/sessions/).
# Скільки тримати сесію без жодного дотику (перегляд потоку теж рахується) і скільки їх максимум.
PLOSHCHA_SESSION_TTL_DAYS=7
PLOSHCHA_MAX_SESSIONS=200
