# === секрети (НІКОЛИ в трек) ===
.env
.env.*
!.env.example
**/.secrets/
*.key
*.pem

# === важкі ваги моделей (качаються окремо) ===
*.gguf
*.safetensors
models/
weights/

# === бази й стан прогонів ===
*.db
*.db-shm
*.db-wal
data/ploshcha/*.json
!data/fixtures/**
eval/reports/

# === збірка / залежності ===
node_modules/
dist/
.vite/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# === документація (робочі документи, НІКОЛИ не в трек і не у віддалене) ===
docs/

# === ОС / редактор ===
.DS_Store
*.swp
.idea/
.vscode/

# === траси прогонів ===
eval/traces/
# черга — робочий стан, не артефакт репо
services/sim/evalkit/data/*.db
services/sim/evalkit/data/*.db-wal
services/sim/evalkit/data/*.db-shm
services/sim/evalkit/data/STOP
.ploshcha.log
apps/web/dist/

# === кеші лінтерів/типів (локальні, не артефакт репо) ===
.ruff_cache/
.mypy_cache/
*.egg-info/
.coverage
htmlcov/

# === чернетки й локальні робочі теки агентів/редакторів ===
scratchpad/
.scratch/
tmp/
.claude/settings.local.json
infra/.env
!infra/.env.example

# Майстер-копії арту (важкі оригінали до стиснення) — тримаємо локально, у збірку не йдуть.
assets/masters/png/
