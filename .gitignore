eval/reports/

# === збірка / залежності ===
node_modules/
dist/
.vite/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# === документація (робочі документи, не в трек) ===
# Доки ведемо ПІД ВЕРСІЯМИ: без історії неможливо побачити, чому правило змінилось — а це прямо
# потрібно і практичному курсу, і нам самим (напр. «ключі спершу з першого значення, потім з усіх»).
# Секретів у доках немає (перевірено). Під ігнором лишаються лише важкі дампи прогонів.
docs/research/eval-runs/
docs/research/traces/

# === ОС / редактор ===
.DS_Store
*.swp
.idea/
.vscode/

